  "setup_instructions": {
    "prerequisites": [
      "Node.js and npm must be installed for npx-based servers",
      "Some servers require API keys or authentication tokens",
      "Environment variables should be set before connecting to servers"
    ],
    "quick_start": [
      "1. Use MCPManager to list available server configurations",
      "2. Use MCPManager to validate configurations and check prerequisites",
      "3. Use MCPClient to connect to desired servers",
      "4. Use MCPClient to list available tools from connected servers",
      "5. Use MCPClient to execute tools with appropriate arguments"
    ],
    "api_keys_required": {
      "github": "Create a GitHub Personal Access Token at https://github.com/settings/tokens",
      "brave_search": "Get a free API key from https://api.search.brave.com/",
      "postgres": "Provide a PostgreSQL connection string"
    },
    "free_servers": [
      "filesystem",
      "git",
      "sqlite",
      "memory",
      "fetch",
      "puppeteer"
    ],
    "servers_requiring_auth": [
      "github",
      "brave_search",
      "postgres"
    ]
